"""Generated Modal application for one editable Cursor worker pool."""

import modal

from modal_cursor import Pool
from modal_cursor.pools import RuntimeSettings
from modal_cursor.spawn import spawn_worker

CURSOR_SECRET_NAME = $secret_name
WORKER_SECRET_NAMES = $worker_secret_names

pool = Pool(name=$pool_name$pool_options)
settings = RuntimeSettings()
app = modal.App($app_name, tags={"service": "modal-cursor"})

cursor_secret = modal.Secret.from_name(CURSOR_SECRET_NAME, required_keys=["CURSOR_API_KEY"])
controller_image = pool.controller_image()
worker = pool.machine(
    image=pool.worker_image(),  # Add application-specific image layers here.
    secrets=[modal.Secret.from_name(name) for name in WORKER_SECRET_NAMES],
    # gpu="A10G",
    # cpu=4,
    # memory=16384,
)


@app.function(
    image=controller_image,
    secrets=[cursor_secret],
    max_containers=1,
    retries=modal.Retries(max_retries=settings.controller_max_retries),
    timeout=settings.controller_timeout_s,
)
def controller() -> None:
    pool.register()
    pool.run_controller()


@app.function(image=controller_image, secrets=[cursor_secret])
def spawner(claim_env: dict[str, object]) -> str:
    return spawn_worker(pool, worker, app, claim_env)
